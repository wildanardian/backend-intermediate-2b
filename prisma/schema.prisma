generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
}

enum ContentType {
  movie
  series
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")

  watchlist        Watchlist[]
  watchProgress    WatchProgress[]
  userSubscription UserSubscription[]

  @@map("users")
}

model Genre {
  id   Int    @id @default(autoincrement())
  name String @unique

  contentGenres ContentGenre[]

  @@map("genres")
}

model Content {
  id          Int         @id @default(autoincrement())
  title       String
  slug        String      @unique
  synopsis    String      @db.Text
  type        ContentType
  posterUrl   String      @map("poster_url")
  bannerUrl   String      @map("banner_url")
  ageRating   String      @map("age_rating")
  releaseYear Int         @map("release_year")
  duration    Int?
  videoUrl    String?     @map("video_url") @db.Text
  isTrending  Boolean     @default(false) @map("is_trending")
  createdAt   DateTime    @default(now()) @map("created_at")

  genres        ContentGenre[]
  episodes      Episode[]
  watchlists    Watchlist[]
  watchProgress WatchProgress[]
  casts         ContentCast[]

  @@index([isTrending])
  @@index([type])
  @@map("contents")
}

model ContentGenre {
  id        Int @id @default(autoincrement())
  contentId Int @map("content_id")
  genreId   Int @map("genre_id")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  genre   Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([contentId, genreId])
  @@index([genreId])
  @@map("content_genres")
}

model Cast {
  id       Int     @id @default(autoincrement())
  name     String
  photoUrl String? @map("photo_url")

  contentCasts ContentCast[]

  @@map("casts")
}

model ContentCast {
  id        Int     @id @default(autoincrement())
  contentId Int     @map("content_id")
  castId    Int     @map("cast_id")
  role      String?

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  cast    Cast    @relation(fields: [castId], references: [id], onDelete: Cascade)

  @@unique([contentId, castId])
  @@map("content_casts")
}

model Episode {
  id            Int     @id @default(autoincrement())
  contentId     Int     @map("content_id")
  episodeNumber Int     @map("episode_number")
  title         String
  description   String? @db.Text
  thumbnailUrl  String? @map("thumbnail_url")
  videoUrl      String  @map("video_url")
  duration      Int?

  content       Content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  watchProgress WatchProgress[]

  @@unique([contentId, episodeNumber])
  @@map("episodes")
}

model Watchlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  contentId Int      @map("content_id")
  addedAt   DateTime @default(now()) @map("added_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("watchlist")
}

model WatchProgress {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  episodeId       Int?     @map("episode_id")
  contentId       Int      @map("content_id")
  progressSeconds Int      @default(0) @map("progress_seconds")
  durationSeconds Int?     @default(0) @map("duration_seconds")
  lastWatchedAt   DateTime @default(now()) @map("last_watched_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  content Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId, contentId])
  @@map("watch_progress")
}

model SubscriptionPlan {
  id         Int     @id @default(autoincrement())
  name       String
  price      Decimal @db.Decimal(10, 2)
  maxDevices Int?    @map("max_devices")
  maxScreens Int?    @map("max_screens")
  features   String? @db.Text

  userSubscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                 Int                @id @default(autoincrement())
  userId             Int                @map("user_id")
  subscriptionPlanId Int                @map("subscription_plan_id")
  status             SubscriptionStatus
  startedAt          DateTime           @default(now()) @map("started_at")
  expiresAt          DateTime?          @map("expires_at")

  user             User             @relation(fields: [userId], references: [id])
  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  @@map("user_subscriptions")
}
